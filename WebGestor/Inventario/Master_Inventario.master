<%@ Master Language="VB" Codefile="Master_Inventario.master.vb" Inherits="Inventario_Master_Inventario" %>

<%@ Register src="../MProyLeft.ascx" tagname="MProyLeft" tagprefix="uc1" %>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" >
<head runat="server">
    <title>Gestor</title>
    <link rel="stylesheet" href="../css/dataTables.bootstrap.min.css" />
    <link rel="stylesheet" href="../css/bootstrap-theme.css" />
    <link rel="stylesheet" href="../css/bootstrap.css" />
    <link rel="stylesheet" href="../css/bootstrapValidator.css" />
    <link rel="stylesheet" href="../css/CSSWeb.css" />
    <link rel="stylesheet" href="../EstiloWebTec.css"/>
    <link rel="stylesheet"  href="../Css_Tab.css" />
    <script src="../js/jquery.min.js" type="text/javascript"></script>
    <script src="../js/dataTables.bootstrap.min.js" type="text/javascript"></script>
    <script src="../js/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="../js/bootstrap.min.js" type="text/javascript"></script>
    <script src="../js/bootstrapValidator.js" type="text/javascript"></script>
    <link href="../EstiloWebTec.css" rel="stylesheet" />
    <script type="text/javascript">
        function MantenSesion() {
            var CONTROLADOR = 'refresh_session.ashx';
            var head = document.getElementsByTagName('head').item(0);
            script = document.createElement('script');
            script.src = CONTROLADOR;
            script.setAtribute('type', 'text/javascript');
            script.defer = true;
            head.appendChild(script);
        }
    </script>
    <style type="text/css">
        .auto-style1 {
            height: 160px;
        }
    </style>
</head>
<body style="vertical-align: middle; text-align: center">
    <form id="form1" runat="server">
        <script type="text/javascript" src="../jsUpdateProgress.js"></script>
        <asp:ScriptManager ID="ScriptManager1" runat="server">
        </asp:ScriptManager>
        <table border="0" cellpadding="0" cellspacing="0" style="width: 1200px; background-color: white;">
            <tr>
                <td align="left" style="width: 200px; height: 160px; background-image: url(../Fotos/proceso.JPG);" valign="top"></td>
                <td align="left" valign="top" class="auto-style1" colspan="2">
                    <img src="../Fotos/LOGO WEBCASH-06.jpg" style="width: 611px" />
                </td>
            </tr>
            <tr>
                <td align="left" colspan="2" style="height: 15px; width: 911px;" valign="top">
                    <asp:LinkButton ID="Inicio" runat="server" Height="15px" PostBackUrl="~/Default.aspx" Width="60px" CssClass="EstiloBoton">Inicio</asp:LinkButton>
                    <asp:LinkButton ID="PaginaP" runat="server" Height="15px" PostBackUrl="~/PaginaPrincipal.aspx" Width="100px" Font-Underline="False" onmouseout="this.style.fontWeight='normal'" onmouseover="this.style.fontWeight='bolder'" CssClass="EstiloBoton">PáginaPrincipal</asp:LinkButton>
                    <asp:LinkButton ID="btnCambioPass" runat="server" Font-Underline="False" Height="15px" PostBackUrl="~/Sistema/SegSistema_CambioContraseña.aspx" Width="120px" onmouseout="this.style.fontWeight='normal'" onmouseover="this.style.fontWeight='bolder'" CssClass="EstiloBoton">Cambiar Contraseña</asp:LinkButton>
                    <asp:LinkButton ID="Cerrar" runat="server" Height="15px" PostBackUrl="~/Salida.aspx" Width="100px" Font-Underline="False" onmouseout="this.style.fontWeight='normal'" onmouseover="this.style.fontWeight='bolder'" CssClass="EstiloBoton">Cerrar Sesión</asp:LinkButton></td>
                <td align="left" style="width: 189px; height: 15px; text-align: right" valign="top">
                    <div id="lblFecha" runat="server" style="font-weight: normal; font-size: 8pt; text-transform: capitalize; width: 150px; color: seagreen; font-family: Arial; height: 16px; text-align: right; display: inline;">
                    </div>
                </td>
            </tr>
            <tr>
                <td align="center" style="width: 200px; height: 17px; background-position: center center; background-repeat: no-repeat; background-color: transparent; text-align: left;" valign="top"></td>
                <td align="left" colspan="2" style="height: 17px; text-align: right; width: 1000px;" valign="top">
                    <div id="lblAgrup" runat="server" style="width: 700px; color: seagreen; font-family: Arial; height: 16px; text-align: right; font-size: 8pt; font-style: italic; display: inline;">
                    </div>
                </td>
            </tr>
            <tr>
                <td align="left" style="width: 200px;" valign="top">
                    <uc1:MProyLeft ID="MProyLeft1" runat="server" />
                </td>
                <td align="left" valign="top" colspan="2" style="width: 1000px;">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </td>
            </tr>
            <tr>
                <td align="center" style="width: 200px; height: 15px" valign="middle"></td>
                <td align="left" style="width: 811px; height: 15px; font-weight: bold; font-size: 13pt; vertical-align: middle; color: darkgray; font-style: italic; text-align: center; font-variant: normal;" valign="center">Derechos Reservados: HAC-DATA</td>
                <td align="left" style="width: 189px; height: 15px" valign="top"></td>
            </tr>
            <tr>
                <td align="center" style="width: 200px; height: 15px" valign="middle"></td>
                <td align="left" style="font-weight: bold; font-size: 13pt; vertical-align: middle; width: 811px; color: darkgray; font-style: italic; height: 15px; font-variant: normal"
                    valign="top"></td>
                <td align="left" style="width: 189px; height: 15px" valign="top"></td>
            </tr>
        </table>
    </form>
</body>
</html>
